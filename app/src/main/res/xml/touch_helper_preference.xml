<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/pref_category_basic">

        <CheckBoxPreference
            app:icon="@drawable/ic_notification"
            app:key="skip_ad_notification"
            app:summaryOff="@string/pref_notify_summary_off"
            app:summaryOn="@string/pref_notify_summary_on"
            app:title="@string/pref_notify_title" />

        <SeekBarPreference
            app:key="skip_ad_duration"
            app:icon="@drawable/ic_duration"
            app:title="@string/pref_duration_title"
            app:summary="@string/pref_duration_summary"
            app:showSeekBarValue="true" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_category_skip">

        <EditTextPreference
            app:key="setting_key_words"
            app:title="@string/pref_keywords_title"
            app:icon="@drawable/ic_keyword"
            app:useSimpleSummaryProvider="true"
            app:dialogTitle="@string/pref_keywords_dialog_title"/>

        <Preference
            app:key="setting_whitelist"
            app:icon="@drawable/ic_happy"
            app:summary="@string/pref_whitelist_summary"
            app:title="@string/pref_whitelist_title" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_category_advanced">

        <Preference
            app:key="setting_activity_customization"
            app:icon="@drawable/ic_target"
            app:summary="@string/pref_add_method_summary"
            app:title="@string/pref_add_method_title" />

        <MultiSelectListPreference
            app:key="setting_activity_widgets"
            app:icon="@drawable/ic_activity_widget"
            app:title="@string/pref_manage_widgets_title"
            app:summary="@string/pref_manage_widgets_summary"
            app:entries="@array/empty_entries"
            app:entryValues="@array/empty_entries"
            app:dialogTitle="@string/pref_manage_dialog_title"/>

        <Preference
            app:key="setting_activity_widgets_advanced"
            app:icon="@drawable/ic_widgets_edit"
            app:summary="@string/pref_import_export_summary"
            app:title="@string/pref_import_export_title" />

        <MultiSelectListPreference
            app:key="setting_activity_positions"
            app:icon="@drawable/ic_activity_position"
            app:title="@string/pref_manage_positions_title"
            app:summary="@string/pref_manage_positions_summary"
            app:entries="@array/empty_entries"
            app:entryValues="@array/empty_entries"
            app:dialogTitle="@string/pref_manage_dialog_title"/>

        <Preference
            app:summary="@string/pref_advanced_help_summary"
            app:icon="@drawable/ic_manual"
            app:title="@string/pref_advanced_help_title">

            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://touchhelper.zfdang.com/settings" />

        </Preference>

    </PreferenceCategory>

</PreferenceScreen>
